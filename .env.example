# URL frontendu - używane przez CORS w backendzie (opcjonalnie)
# FRONTEND_URL=http://localhost:5173

# Port backendu (domyślnie 3001)
# PORT=3001

# Własny identyfikator wydawcy Google AdSense - zamień placeholder w:
# - frontend/public/ads.txt
# - frontend/index.html
# - frontend/src/components/AdBanner.jsx
# ADSENSE_PUB=pub-0000000000000000

# Kod weryfikacyjny Google Search Console / AdSense
# GOOGLE_SITE_VERIFICATION=PLACEHOLDER_WPROWADZ_KOD
