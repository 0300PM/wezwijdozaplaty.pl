generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id                    String   @id @default(uuid())
  email                 String
  stripeSessionId       String   @unique
  stripePaymentIntentId String?
  amount                Decimal
  status                String   @default("pending")
  pdfUrl                String?
  createdAt             DateTime @default(now())
}